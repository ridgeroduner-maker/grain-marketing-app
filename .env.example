# Copy to .env (git-ignored) and fill in. NEVER commit .env.

# Google Maps JavaScript API browser key (placeholder only). It ends up PUBLIC in the page, so restrict it in Google Cloud:
#   Application restriction: Websites (HTTP referrers) -> your site URL(s) only
#   API restriction: Maps JavaScript API only
# Leave empty to run with the plain no-tile map.
GOOGLE_MAPS_API_KEY=

# Only needed for the MARS API (history backfill); the daily PDF path needs no key.
USDA_AMS_API_KEY=
