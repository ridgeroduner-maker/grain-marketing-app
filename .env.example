# Copy to .env (git-ignored) and fill in. NEVER commit .env.

# The default map (self-hosted tiles/plains.pmtiles, see README "Map") needs NO key and NO account.
# Only if you switch MAP_TILES_URL in public/config.js to a keyed raster provider (MapTiler, Stadia, Thunderforest ...) put its key here;
# it is substituted for {key} in the URL and ends up PUBLIC in the page, so restrict it to your site in that provider's dashboard.
MAP_TILES_KEY=

# Only needed for the MARS API (history backfill); the daily PDF path needs no key.
USDA_AMS_API_KEY=
